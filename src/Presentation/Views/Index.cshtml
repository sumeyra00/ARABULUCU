@model ARABULUCU.Web.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="py-5" style="background: radial-gradient(circle at 50% 10%, #FFF0F4 0%, #FFF7F9 55%, #FCF9F9 100%); min-height: 100vh;">
    <div class="container" style="max-width: 1200px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1 text-dark">🛡️ Admin Yönetim Paneli</h1>
                <p class="text-muted small mb-0">İlanları yönetin, teslim durumlarını güncelleyin ve gelen iletişim mesajlarını inceleyin.</p>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold bg-white border shadow-sm text-dark">
                &larr; Siteye Dön
            </a>
        </div>

        @if (TempData["AdminSuccess"] is string adminSuccess)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
                @adminSuccess
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <!-- Özet Kartlar -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small">Toplam İlan</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalItems</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small">Kayıp İlan</div>
                        <div class="fs-4 fw-bold text-danger">@Model.LostItemsCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small">Bulunan İlan</div>
                        <div class="fs-4 fw-bold text-success">@Model.FoundItemsCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small">Teslim Edilen</div>
                        <div class="fs-4 fw-bold text-primary">@Model.DeliveredItemsCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small">Kullanıcı</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalUsersCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small">İletişim / Sohbet</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalSubmissionsCount / @Model.TotalChatMessagesCount</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtre ve Arama -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <form method="get" asp-controller="Admin" asp-action="Index" class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <input type="text" name="q" value="@Model.SearchQuery" class="form-control rounded-pill px-3" placeholder="Başlık, konum, kategori veya kullanıcı ara..." />
                    </div>
                    <div class="col-md-4">
                        <select name="filter" class="form-select rounded-pill px-3">
                            <option value="all" selected="@(Model.ActiveFilter == "all")">Tüm İlanlar</option>
                            <option value="open" selected="@(Model.ActiveFilter == "open")">Açık İlanlar</option>
                            <option value="lost" selected="@(Model.ActiveFilter == "lost")">Yalnızca Kayıp</option>
                            <option value="found" selected="@(Model.ActiveFilter == "found")">Yalnızca Bulunan</option>
                            <option value="delivered" selected="@(Model.ActiveFilter == "delivered")">Teslim Edilenler</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold w-100">Filtrele</button>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Sıfırla</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- İlan Tablosu -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h2 class="h6 fw-bold mb-0">İlan Yönetimi (@Model.Items.Count)</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Tür</th>
                            <th>Başlık</th>
                            <th>Kategori</th>
                            <th>Konum</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Filtreye uygun ilan bulunamadı.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">#@item.Id</td>
                                    <td>
                                        <span class="badge @(item.IsFound ? "text-bg-success" : "text-bg-danger")">
                                            @(item.IsFound ? "Bulunan" : "Kayıp")
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@item.Title</td>
                                    <td>@(item.Category?.Name ?? "-")</td>
                                    <td class="small text-muted">@item.Location</td>
                                    <td class="small">@item.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (item.IsDelivered)
                                        {
                                            <span class="badge text-bg-primary">Teslim Edildi</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-light border">Açık</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="Home" asp-action="Detay" asp-route-ilanId="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2">Detay</a>
                                        <form asp-controller="Admin" asp-action="ToggleDelivered" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                @(item.IsDelivered ? "Açık Yap" : "Teslim Edildi")
                                            </button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- İletişim Formu Mesajları -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h2 class="h6 fw-bold mb-0">Son İletişim Mesajları (@Model.ContactSubmissions.Count)</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Gönderen</th>
                            <th>E-posta</th>
                            <th>Konu</th>
                            <th>Mesaj</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ContactSubmissions.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Henüz iletişim mesajı bulunmuyor.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var msg in Model.ContactSubmissions)
                            {
                                <tr>
                                    <td class="fw-semibold">@msg.Name</td>
                                    <td class="small">@msg.Email</td>
                                    <td><span class="badge text-bg-light border">@msg.Subject</span></td>
                                    <td class="small" style="max-width: 380px;">@msg.Message</td>
                                    <td class="small text-muted">@msg.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <form asp-controller="Admin" asp-action="DeleteSubmission" method="post" class="d-inline" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@msg.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>