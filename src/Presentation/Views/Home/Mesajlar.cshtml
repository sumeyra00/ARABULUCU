@{
    ViewData["Title"] = "Mesajlarım";
}

<!-- Leaflet Harita Kütüphanesi -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container py-4" id="chatApp" data-item-id="@ViewData["IlanId"]">
    <div class="card shadow-sm border rounded-3 overflow-hidden">
        <div class="row g-0" style="min-height: 580px;">
            
            <!-- Sol Panel: Konuşma Listesi -->
            <div class="col-md-4 border-end bg-light">
                <div class="p-3 border-bottom bg-white">
                    <h5 class="fw-bold mb-2">Sohbetler</h5>
                    <input type="text" class="form-control form-control-sm" placeholder="Sohbetlerde ara..." />
                </div>

                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action active p-3" aria-current="true">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold">İlan #@ViewData["IlanId"]</span>
                            <small id="chatStatus" class="opacity-75">Bağlanıyor...</small>
                        </div>
                        <div class="small fw-semibold mb-1 text-truncate">İlan sohbeti</div>
                        <p class="small mb-0 opacity-75 text-truncate">SignalR ile canlı mesajlaşma</p>
                    </a>

                </div>
            </div>

            <!-- Sağ Panel: Aktif Mesajlaşma Penceresi -->
            <div class="col-md-8 d-flex flex-column bg-white">
                
                <!-- Üst Başlık -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                            💬
                        </div>
                        <div>
                            <div class="fw-bold">İlan #@ViewData["IlanId"] sohbeti</div>
                            <small class="text-muted">SignalR canlı sohbet</small>
                        </div>
                    </div>
                    <div>
                        <a href="/Home/Detay?ilanId=@ViewData["IlanId"]" class="btn btn-sm btn-outline-secondary">İlanı Gör</a>
                    </div>
                </div>

                <!-- Güvenlik Bilgilendirmesi -->
                <div class="px-3 pt-2">
                    <div class="alert alert-light border small text-muted py-2 mb-0 text-center">
                        🔒 Sohbetler ilan numarasına göre ayrılır. Hassas kişisel bilgilerinizi paylaşmayın ve teslimat için açık kampüs alanlarını tercih edin.
                    </div>
                </div>

                <!-- Mesaj Balonları -->
                <div id="chatMessages" class="flex-grow-1 p-3 overflow-auto" style="background-color: #F8FAFC;" aria-live="polite">
                </div>

                <!-- Alt Mesaj Gönderme Çubuğu -->
                <div class="p-3 border-top bg-white">
                    <form id="chatForm" class="d-flex gap-2 align-items-center">
                        <!-- CHAT İÇİ CANLI KONUM PAYLAŞ BUTONU -->
                        <button type="button" class="btn btn-outline-danger fw-semibold d-flex align-items-center gap-1 text-nowrap" data-bs-toggle="modal" data-bs-target="#locationModal">
                            📍 Konum Paylaş
                        </button>

                        <input id="chatInput" type="text" class="form-control" placeholder="Bir mesaj yazın..." maxlength="2000" autocomplete="off" required />
                        <button id="sendButton" type="submit" class="btn btn-primary fw-bold px-4" disabled>Gönder</button>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- CHAT İÇİ BULUŞMA NOKTASI / KONUM PAYLAŞMA MODALI -->
<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="locationModalLabel">📍 Teslimat / Buluşma Konumu Paylaş</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Mevcut konumunuzu alabilir veya kampüs haritasından tıklayarak teslimat noktası seçebilirsiniz.</span>
                    <button type="button" class="btn btn-sm btn-danger fw-bold" id="btnLiveLocation">
                        🎯 Canlı GPS Konumumu Al
                    </button>
                </div>

                <!-- Modal İçi Mini Harita -->
                <div id="chatMap" class="rounded-3 border mb-3" style="height: 280px; width: 100%; background: #f0f0f0;"></div>

                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Konum Başlığı / Yakın Bina</label>
                        <input type="text" class="form-control form-control-sm" id="chatPlaceName" placeholder="Örn: Merkez Kütüphane Önü" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Buluşma Notu (Opsiyonel)</label>
                        <input type="text" class="form-control form-control-sm" id="chatMeetingNote" placeholder="Örn: Yeşil banklardayım, mavi kazaklıyım" />
                    </div>
                    <input type="hidden" id="chatLat" />
                    <input type="hidden" id="chatLng" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-success fw-bold" id="sendLocationButton">
                    ✓ Konumu Sohbete Gönder
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS ve Harita Scripti -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const chatApp = document.getElementById('chatApp');
    const chatMessages = document.getElementById('chatMessages');
    const chatStatus = document.getElementById('chatStatus');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const sendButton = document.getElementById('sendButton');
    const conversationId = Number(chatApp.dataset.itemId);
    const nameStorageKey = 'arabulucu-chat-display-name';
    let displayName = localStorage.getItem(nameStorageKey);
    if (!displayName) {
        displayName = window.prompt('Sohbette kullanılacak adınız:')?.trim();
        if (displayName) {
            localStorage.setItem(nameStorageKey, displayName);
        }
    }

    function appendMessage(message) {
        const ownMessage = message.sender === displayName;
        const wrapper = document.createElement('div');
        wrapper.className = `d-flex flex-column ${ownMessage ? 'align-items-end' : 'align-items-start'} mb-3`;

        const bubble = document.createElement('div');
        bubble.className = `p-2 px-3 rounded-3 shadow-sm ${ownMessage ? 'bg-primary text-white' : 'bg-white border'} small`;
        bubble.style.maxWidth = '75%';
        bubble.textContent = `${message.sender}: ${message.message}`;

        const timestamp = document.createElement('span');
        timestamp.className = 'text-muted mt-1 px-1';
        timestamp.style.fontSize = '0.7rem';
        timestamp.textContent = new Date(message.sentAt).toLocaleString();

        wrapper.append(bubble, timestamp);
        chatMessages.appendChild(wrapper);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/chat')
        .withAutomaticReconnect()
        .build();

    connection.on('ReceiveMessage', appendMessage);
    connection.onreconnecting(() => {
        chatStatus.textContent = 'Yeniden bağlanıyor...';
        sendButton.disabled = true;
    });
    connection.onreconnected(async () => {
        try {
            await joinConversation();
        } catch (error) {
            chatStatus.textContent = 'Sohbete yeniden katılınamadı';
            console.error('Sohbete yeniden katılınamadı:', error);
        }
    });
    connection.onclose(() => {
        chatStatus.textContent = 'Bağlantı kesildi';
        sendButton.disabled = true;
    });

    async function joinConversation() {
        const history = await connection.invoke('JoinConversation', conversationId, displayName);
        chatMessages.replaceChildren();
        history.forEach(appendMessage);
        chatStatus.textContent = 'Bağlandı';
        sendButton.disabled = false;
    }

    async function connect() {
        if (!displayName) {
            chatStatus.textContent = 'Sohbete katılmak için bir ad gerekli';
            chatInput.disabled = true;
            return;
        }

        try {
            await connection.start();
            await joinConversation();
        } catch (error) {
            chatStatus.textContent = 'Bağlanılamadı, yeniden deneniyor...';
            console.error('Sohbet bağlantısı kurulamadı:', error);
            window.setTimeout(connect, 5000);
        }
    }

    chatForm.addEventListener('submit', async event => {
        event.preventDefault();
        const message = chatInput.value.trim();
        if (!message || connection.state !== signalR.HubConnectionState.Connected) {
            return;
        }

        sendButton.disabled = true;
        try {
            await connection.invoke('SendMessage', message);
            chatInput.value = '';
            chatInput.focus();
        } catch (error) {
            chatStatus.textContent = error.message || 'Mesaj gönderilemedi';
        } finally {
            sendButton.disabled = connection.state !== signalR.HubConnectionState.Connected;
        }
    });

    document.getElementById('sendLocationButton').addEventListener('click', async () => {
        const latitude = document.getElementById('chatLat').value;
        const longitude = document.getElementById('chatLng').value;
        const place = document.getElementById('chatPlaceName').value.trim();
        const note = document.getElementById('chatMeetingNote').value.trim();
        if (!latitude || !longitude) {
            chatStatus.textContent = 'Önce haritadan bir konum seçin';
            return;
        }

        const message = `📍 ${place || 'Buluşma noktası'}: ${latitude}, ${longitude}${note ? ` — ${note}` : ''}`;
        try {
            await connection.invoke('SendMessage', message);
            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        } catch (error) {
            chatStatus.textContent = error.message || 'Konum gönderilemedi';
        }
    });

    connect();

    let chatMapInitialized = false;
    let chatMap;
    let chatMarker;

    const modalEl = document.getElementById('locationModal');
    if (modalEl) {
        modalEl.addEventListener('shown.bs.modal', function () {
            if (!chatMapInitialized) {
                chatMap = L.map('chatMap').setView([39.7047, 37.0395], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap'
                }).addTo(chatMap);

                chatMap.on('click', function (e) {
                    setChatLocation(e.latlng.lat, e.latlng.lng, "Seçilen Buluşma Noktası");
                });

                chatMapInitialized = true;
            } else {
                chatMap.invalidateSize();
            }
        });
    }

    function setChatLocation(lat, lng, label) {
        if (chatMarker) {
            chatMarker.setLatLng([lat, lng]);
        } else {
            chatMarker = L.marker([lat, lng]).addTo(chatMap);
        }
        chatMarker.bindPopup(`<b>${label}</b>`).openPopup();
        chatMap.setView([lat, lng], 17);
        document.getElementById('chatLat').value = lat;
        document.getElementById('chatLng').value = lng;
    }

    const liveBtn = document.getElementById('btnLiveLocation');
    if (liveBtn) {
        liveBtn.addEventListener('click', function () {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    pos => setChatLocation(pos.coords.latitude, pos.coords.longitude, "Canlı Konumunuz"),
                    error => { chatStatus.textContent = `Konum alınamadı: ${error.message}`; });
            } else {
                chatStatus.textContent = 'Tarayıcınız konum desteği sunmuyor';
            }
        });
    }
</script>