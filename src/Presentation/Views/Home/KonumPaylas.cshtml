@{
    ViewData["Title"] = "Konum Paylaşımı ve Buluşma Noktası";
}

<!-- Leaflet Harita Kütüphanesi -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="position-relative overflow-hidden py-5" style="background: radial-gradient(circle at 50% 15%, #FFF0F4 0%, #FFF7F9 60%, #FCF9F9 100%); min-height: 100vh;">

    <!-- Sevimli Süs Figürleri -->
    <div class="position-absolute d-none d-lg-block" style="top: 6%; left: 5%; font-size: 2.2rem; transform: rotate(-15deg); user-select: none;">📍</div>
    <div class="position-absolute d-none d-lg-block" style="top: 8%; right: 6%; font-size: 2.4rem; transform: rotate(18deg); user-select: none;">🌸</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 8%; left: 4%; font-size: 2rem; transform: rotate(12deg); user-select: none;">✨</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 10%; right: 5%; font-size: 2.2rem; transform: rotate(-12deg); user-select: none;">🗺️</div>

    <div class="container position-relative" style="z-index: 2; max-width: 900px;">
        
        <!-- Üst Geri Dön Butonu -->
        <div class="mb-3">
            <a href="/Home/Mesajlar" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-dark shadow-sm bg-white border">
                &larr; Mesajlara Dön
            </a>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);">
            
            <!-- Kart Başlığı -->
            <div class="card-header border-bottom py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: linear-gradient(135deg, #FFF0F4 0%, #FFE2EA 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); font-size: 1.2rem;">
                        📍
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Kampüs İçi Canlı Konum & Buluşma Noktası</h5>
                        <p class="text-muted small mb-0">Eşya teslimi için mevcut konumunuzu alın veya haritadan güvenli bir nokta seçin.</p>
                    </div>
                </div>
                <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #FFFFFF; color: #FF416C; border: 1px solid #FFD9E2;">
                    🌸 SCÜ Kampüsü
                </span>
            </div>

            <div class="card-body p-4 p-md-5">
                
                <!-- Butonlar ve Durum Alanı -->
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn rounded-pill px-3 py-2 fw-bold text-white shadow-sm d-flex align-items-center gap-2" id="btnGetLocation" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); border: none;">
                            🎯 Canlı Konumumu Ekle
                        </button>
                        <button type="button" class="btn btn-pink-outline rounded-pill px-3 py-2 fw-semibold small" id="btnCampusCenter" style="border: 1.5px solid #FFD9E2; color: #FF416C; background-color: #FFF7F9;">
                            🏫 Kampüs Merkezine Git
                        </button>
                    </div>
                    <div id="locationStatus" class="small text-muted fw-semibold py-1 px-3 rounded-pill bg-light border">
                        Haritaya tıklayarak da nokta seçebilirsiniz.
                    </div>
                </div>

                <!-- HARİTA GÖSTERİM ALANI -->
                <div id="map" class="rounded-4 border mb-4 shadow-sm" style="height: 380px; width: 100%; background: #f0f0f0;"></div>

                <!-- Form Inputları -->
                <form method="post" action="#">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">Enlem (Latitude)</label>
                            <input type="text" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none small" id="latitudeInput" name="latitude" placeholder="Örn: 39.7042" readonly required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">Boylam (Longitude)</label>
                            <input type="text" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none small" id="longitudeInput" name="longitude" placeholder="Örn: 37.0398" readonly required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">Seçilen / Yakın Yer</label>
                            <input type="text" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none small" id="placeName" name="placeName" placeholder="Örn: Kütüphane Önü" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Buluşma / Teslimat Notu</label>
                            <input type="text" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" name="meetingNote" placeholder="Örn: Kütüphane önündeki mavi banklardayım, üzerimde siyah mont var." />
                        </div>

                        <!-- Gönderme Butonları -->
                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                            <a href="/Home/Mesajlar" class="btn btn-light rounded-pill px-4 py-2 fw-semibold border">
                                Vazgeç
                            </a>
                            <button type="submit" class="btn rounded-pill px-4 py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%); border: none;">
                                ✓ Bu Konumu Paylaş
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<!-- Leaflet JS ve Konum Alma Scripti -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const SCU_LAT = 39.7047;
    const SCU_LNG = 37.0395;

    const map = L.map('map').setView([SCU_LAT, SCU_LNG], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    let marker;

    function updateMarker(lat, lng, title = "Buluşma Noktası") {
        if (marker) {
            marker.setLatLng([lat, lng]);
        } else {
            marker = L.marker([lat, lng], { draggable: true }).addTo(map);
            
            marker.on('dragend', function (e) {
                const pos = marker.getLatLng();
                setInputs(pos.lat, pos.lng, "İşaretçi sürüklendi");
            });
        }
        marker.bindPopup(`<b>${title}</b><br>Lat: ${lat.toFixed(5)}, Lng: ${lng.toFixed(5)}`).openPopup();
        map.setView([lat, lng], 17);
        setInputs(lat, lng, title);
    }

    function setInputs(lat, lng, info) {
        document.getElementById('latitudeInput').value = lat.toFixed(6);
        document.getElementById('longitudeInput').value = lng.toFixed(6);
        document.getElementById('locationStatus').innerHTML = `✅ ${info} (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
    }

    document.getElementById('btnGetLocation').addEventListener('click', function () {
        const status = document.getElementById('locationStatus');
        
        if (!navigator.geolocation) {
            status.innerHTML = "❌ Tarayıcınız canlı konum desteği vermiyor.";
            return;
        }

        status.innerHTML = "⏳ Canlı GPS konumunuz alınıyor...";

        navigator.geolocation.getCurrentPosition(
            function (position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                updateMarker(lat, lng, "Mevcut Canlı Konumunuz");
            },
            function (error) {
                status.innerHTML = "⚠️ Konum izni verilmedi veya alınamadı. Haritadan tıklayarak seçebilirsiniz.";
            },
            { enableHighAccuracy: true, timeout: 10000 }
        );
    });

    map.on('click', function (e) {
        updateMarker(e.latlng.lat, e.latlng.lng, "Seçilen Nokta");
    });

    document.getElementById('btnCampusCenter').addEventListener('click', function () {
        updateMarker(SCU_LAT, SCU_LNG, "Sivas Cumhuriyet Üniversitesi Merkez");
    });
</script>