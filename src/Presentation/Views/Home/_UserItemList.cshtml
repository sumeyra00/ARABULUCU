@model IReadOnlyCollection<ARABULUCU.Web.Controllers.UserItemViewModel>

<div class="card shadow-sm border rounded-3">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center p-4 mb-0">Bu bölümde henüz ilanınız yok.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>İlan Başlığı</th>
                            <th>Kategori</th>
                            <th>Konum</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.Category</td>
                                <td><small class="text-muted">@item.Location</small></td>
                                <td>
                                    <small class="text-muted">@item.Date.ToString("dd.MM.yyyy HH:mm")</small><br />
                                    @if (item.IsItemFound)
                                    {
                                        <span class="badge text-bg-success">Bulundu</span>
                                    }
                                    @if (item.IsDelivered)
                                    {
                                        <span class="badge text-bg-secondary">Teslim edildi</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="/Home/IlanGuncelle?id=@item.Id"
                                       class="btn btn-sm btn-outline-primary">Güncelle</a>
                                    <form asp-controller="Home" asp-action="IlanSil" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
