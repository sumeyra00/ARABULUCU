@model IReadOnlyCollection<ARABULUCU.Web.Controllers.UserItemViewModel>

<div class="card shadow-sm border rounded-3">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center p-4 mb-0">Bu bölümde henüz ilanınız yok.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>İlan Başlığı</th>
                            <th>Kategori</th>
                            <th>Konum</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.Category</td>
                                <td><small class="text-muted">@item.Location</small></td>
                                <td><small class="text-muted">@item.Date.ToString("dd.MM.yyyy HH:mm")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
