@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="position-relative overflow-hidden py-5" style="background: radial-gradient(circle at 50% 15%, #FFF0F4 0%, #FFF7F9 60%, #FCF9F9 100%); min-height: 100vh;">

    <!-- Sevimli Süs Figürleri -->
    <div class="position-absolute d-none d-lg-block" style="top: 8%; left: 5%; font-size: 2.2rem; transform: rotate(-15deg); user-select: none;">🌸</div>
    <div class="position-absolute d-none d-lg-block" style="top: 10%; right: 6%; font-size: 2.4rem; transform: rotate(18deg); user-select: none;">✨</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 8%; left: 6%; font-size: 2rem; transform: rotate(12deg); user-select: none;">🤝</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 10%; right: 5%; font-size: 2.2rem; transform: rotate(-12deg); user-select: none;">💖</div>

    <div class="container position-relative" style="z-index: 2; max-width: 920px;">
        
        <!-- Üst Geri Dön Butonu -->
        <div class="mb-3">
            <a href="/" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-dark shadow-sm bg-white border">
                &larr; Ana Sayfaya Dön
            </a>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);">
            
            <!-- Kart Başlığı -->
            <div class="card-header border-bottom py-4 px-4 px-md-5 text-center" style="background: linear-gradient(135deg, #FFF0F4 0%, #FFE2EA 100%);">
                <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm mb-3" style="width: 56px; height: 56px; background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); font-size: 1.6rem; box-shadow: 0 4px 12px rgba(255, 96, 130, 0.35);">
                    🔍
                </div>
                <h3 class="fw-bold mb-1 text-dark">Arabulucu Nedir?</h3>
                <p class="text-muted small mb-0">Sivas Cumhuriyet Üniversitesi Kampüs İçi Güvenli Kayıp Eşya & Dayanışma Portalı</p>
            </div>

            <div class="card-body p-4 p-md-5">
                
                <!-- Misyonumuz -->
                <div class="mb-5 text-center px-md-4">
                    <span class="badge rounded-pill px-3 py-2 fw-semibold mb-3" style="background-color: #FFF0F4; color: #FF416C; border: 1px solid #FFD9E2;">
                        🌸 Misyonumuz
                    </span>
                    <h5 class="fw-bold text-dark mb-3">Kaybedilen Eşyaları Gerçek Sahipleriyle Güvenle Buluşturuyoruz</h5>
                    <p class="text-secondary small leading-relaxed">
                        Arabulucu, üniversite kampüsümüzde unutulan veya kaybedilen eşyaların karmaşık WhatsApp ve sosyal medya gruplarında kaybolmasını engellemek amacıyla geliştirilmiştir. Modern doğrulama adımları ve güvenli konum paylaşım teknolojileri sayesinde eşyalar doğrudan gerçek sahibine teslim edilir.
                    </p>
                </div>

                <!-- 3 Önemli Özellik Kartı -->
                <div class="row g-3 mb-5">
                    <div class="col-md-4">
                        <div class="p-4 rounded-4 border h-100 text-center" style="background-color: #FFFDFD; border-color: #FFD9E2 !important;">
                            <div class="fs-2 mb-2">🔒</div>
                            <h6 class="fw-bold text-dark mb-2">Sahiplik Doğrulama</h6>
                            <p class="text-muted small mb-0">Eşyayı bulan kişinin belirlediği gizli detay sorusu yanıtlanmadan eşleşme gerçekleşmez.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 rounded-4 border h-100 text-center" style="background-color: #FFFDFD; border-color: #FFD9E2 !important;">
                            <div class="fs-2 mb-2">💬</div>
                            <h6 class="fw-bold text-dark mb-2">Canlı & Güvenli Sohbet</h6>
                            <p class="text-muted small mb-0">Telefon numarası veya kişisel veri paylaşmadan sistem üzerinden SignalR ile anlık mesajlaşma imkânı.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 rounded-4 border h-100 text-center" style="background-color: #FFFDFD; border-color: #FFD9E2 !important;">
                            <div class="fs-2 mb-2">📍</div>
                            <h6 class="fw-bold text-dark mb-2">Kampüs Haritası</h6>
                            <p class="text-muted small mb-0">Buluşma noktası olarak kampüsün güvenli alanlarını harita üzerinden işaretleme kolaylığı.</p>
                        </div>
                    </div>
                </div>

                <!-- Geliştirici / Ekip Notu -->
                <div class="p-4 rounded-4 border text-center" style="background: linear-gradient(135deg, #FFF5F7 0%, #FFFDFD 100%); border-color: #FFD9E2 !important;">
                    <h6 class="fw-bold text-dark mb-1">🎓 Üniversite Dayanışma Projesi</h6>
                    <p class="text-muted small mb-3">Bu platform Sivas Cumhuriyet Üniversitesi öğrencileri tarafından kampüs hayatını kolaylaştırmak amacıyla tasarlanmıştır.</p>
                    <a href="/Home/Iletisim" class="btn btn-sm rounded-pill px-4 py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); border: none;">
                        Bizimle İletişime Geçin
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>