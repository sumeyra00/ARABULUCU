@{
    ViewData["Title"] = "Profilim ve İlanlarım";
}

<div class="position-relative overflow-hidden py-5" style="background: radial-gradient(circle at 50% 15%, #FFF0F4 0%, #FFF7F9 60%, #FCF9F9 100%); min-height: 100vh;">

    <!-- Sevimli Süs Figürleri -->
    <div class="position-absolute d-none d-lg-block" style="top: 5%; left: 4%; font-size: 2.2rem; transform: rotate(-15deg); user-select: none;">🌸</div>
    <div class="position-absolute d-none d-lg-block" style="top: 8%; right: 5%; font-size: 2.4rem; transform: rotate(18deg); user-select: none;">✨</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 8%; left: 5%; font-size: 2.2rem; transform: rotate(12deg); user-select: none;">💖</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 10%; right: 4%; font-size: 2rem; transform: rotate(-12deg); user-select: none;">📋</div>

    <div class="container position-relative" style="z-index: 2; max-width: 1000px;">
        
        <!-- Profil Üst Kartı -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);">
            <div class="card-body p-4 p-md-5 d-flex align-items-center justify-content-between flex-wrap gap-4" style="background: linear-gradient(135deg, #FFF9FA 0%, #FFFFFF 100%);">
                <div class="d-flex align-items-center gap-4">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm border border-2 border-white flex-shrink-0" style="width: 72px; height: 72px; background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); box-shadow: 0 4px 14px rgba(255, 96, 130, 0.35);">
                        FN
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold text-dark mb-0">Fatmanur A.</h4>
                            <span class="badge rounded-pill px-3 py-1 fw-semibold small" style="background-color: #FFF0F4; color: #FF416C; border: 1px solid #FFD9E2;">
                                Öğrenci Hesabı
                            </span>
                        </div>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-mortarboard-fill me-1" style="color: #FF6082;"></i> Sivas Cumhuriyet Üniversitesi • Mühendislik Fakültesi
                        </p>
                        <span class="text-secondary small fw-medium">ornek@cumhuriyet.edu.tr</span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="/Home/KayipOlustur" class="btn btn-sm rounded-pill px-3 py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); border: none;">
                        + Yeni Kayıp İlanı
                    </a>
                    <a href="/Home/BulunanOlustur" class="btn btn-sm rounded-pill px-3 py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%); border: none;">
                        + Yeni Buluntu Bildir
                    </a>
                </div>
            </div>
        </div>

        <!-- Sekmeler (Tabs) -->
        <ul class="nav nav-pills gap-2 mb-4 p-2 rounded-4 bg-white border shadow-sm" id="profileTab" role="tablist" style="border-color: rgba(255, 96, 130, 0.15) !important;">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 py-2 fw-bold small text-dark" id="items-tab" data-bs-toggle="tab" data-bs-target="#items-tab-pane" type="button" role="tab">
                    📋 İlanlarım <span class="badge rounded-pill bg-light text-dark ms-1">3</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 py-2 fw-bold small text-secondary" id="requests-tab" data-bs-toggle="tab" data-bs-target="#requests-tab-pane" type="button" role="tab">
                    🔒 Gelen Doğrulama Cevapları <span class="badge rounded-pill text-white ms-1" style="background-color: #FF6082;">1</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 py-2 fw-bold small text-secondary" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-tab-pane" type="button" role="tab">
                    ⚙️ Hesap Ayarları
                </button>
            </li>
        </ul>

        <!-- Sekme İçerikleri -->
        <div class="tab-content" id="profileTabContent">
            
            <!-- 1. SEKME: İlanlarım -->
            <div class="tab-pane fade show active" id="items-tab-pane" role="tabpanel">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98);">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background: linear-gradient(135deg, #FFF0F4 0%, #FFE2EA 100%);">
                                    <tr class="text-secondary small fw-bold">
                                        <th class="ps-4 py-3">Tür</th>
                                        <th class="py-3">İlan Başlığı</th>
                                        <th class="py-3">Konum</th>
                                        <th class="py-3">Tarih</th>
                                        <th class="py-3">Durum</th>
                                        <th class="text-end pe-4 py-3">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- 1. İlan -->
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge rounded-pill px-3 py-1 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%);">
                                                Kayıp
                                            </span>
                                        </td>
                                        <td><strong class="text-dark">Siyah Deri Sırt Çantası</strong></td>
                                        <td><small class="text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i>Merkez Kütüphane</small></td>
                                        <td><small class="text-muted">18.10.2026</small></td>
                                        <td>
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">
                                                🔍 Aramada
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-inline-flex gap-1">
                                                <a href="/Home/Detay" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold shadow-none">Görüntüle</a>
                                                <button class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold shadow-none">✓ Çözüldü</button>
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold shadow-none">Sil</button>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- 2. İlan -->
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge rounded-pill px-3 py-1 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                                                Bulundu
                                            </span>
                                        </td>
                                        <td><strong class="text-dark">Mavi Çelik Termos</strong></td>
                                        <td><small class="text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i>Merkez Yemekhane</small></td>
                                        <td><small class="text-muted">15.10.2026</small></td>
                                        <td>
                                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-1">
                                                ✨ Teslim Edildi
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-inline-flex gap-1">
                                                <a href="/Home/Detay" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold shadow-none">Görüntüle</a>
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold shadow-none" disabled>Sil</button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. SEKME: Gelen Doğrulama Talepleri -->
            <div class="tab-pane fade" id="requests-tab-pane" role="tabpanel">
                <div class="card border-0 shadow-lg rounded-4 p-4" style="background: rgba(255, 255, 255, 0.98);">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <span>🔒</span> İlanlarınıza Gelen Eşleşme Yanıtları
                        </h6>
                        <span class="badge rounded-pill px-3 py-1" style="background-color: #FFF0F4; color: #FF416C; border: 1px solid #FFD9E2;">
                            1 Yeni Yanıt
                        </span>
                    </div>
                    
                    <!-- Tek Talep Kartı -->
                    <div class="p-4 rounded-4 border mb-3" style="background-color: #FFFDFD; border-color: #FFD9E2 !important;">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%);">
                                    AK
                                </div>
                                <div>
                                    <strong class="text-dark">Ahmet K.</strong>
                                    <div class="small text-muted"><em>"Siyah Deri Sırt Çantası"</em> ilanınızın doğrulama sorusuna cevap verdi.</div>
                                </div>
                            </div>
                            <small class="badge rounded-pill bg-light text-muted border px-3 py-1">19:15</small>
                        </div>
                        
                        <div class="small text-secondary mb-2 p-2 rounded-3 bg-light border">
                            <strong class="text-dark">Sorduğunuz Soru:</strong> Çantanın ön gözündeki küçük anahtarlıkta hangi figür vardı?
                        </div>
                        
                        <div class="small p-3 rounded-4 border mb-3" style="background-color: #FFF3F6; border-color: #FFD9E2 !important;">
                            <strong class="text-dark">Kullanıcının Cevabı:</strong> 
                            <span class="text-muted">"Küçük sarı bir ayıcık figürü vardı, fermuarında da yeşil ip takılı."</span>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <a href="/Home/Mesajlar" class="btn btn-sm rounded-pill px-4 py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                                ✓ Doğrula & Sohbet Başlat
                            </a>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-2 fw-semibold">
                                ✕ Reddet
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. SEKME: Hesap Ayarları -->
            <div class="tab-pane fade" id="settings-tab-pane" role="tabpanel">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5" style="background: rgba(255, 255, 255, 0.98);">
                    <div class="mb-4 pb-2 border-bottom">
                        <h6 class="fw-bold text-dark mb-1">⚙️ Bilgileri Güncelle</h6>
                        <p class="text-muted small mb-0">Hesap bilgilerinizi ve iletişim tercihlerinizi buradan düzenleyebilirsiniz.</p>
                    </div>

                    <form class="row g-3" style="max-width: 650px;">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Ad Soyad</label>
                            <input type="text" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" value="Fatmanur A." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Telefon Numarası</label>
                            <input type="tel" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" placeholder="05XX XXX XX XX" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Yeni Şifre (Değiştirmek istemiyorsanız boş bırakın)</label>
                            <input type="password" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" placeholder="••••••••" />
                        </div>
                        <div class="col-12 pt-2">
                            <button type="submit" class="btn rounded-pill px-4 py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); border: none;">
                                Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Sekme Butonu Aktif Renk Ayarı */
    .nav-pills .nav-link.active {
        background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(255, 96, 130, 0.35);
    }
    .nav-pills .nav-link:hover:not(.active) {
        background-color: #FFF0F4;
        color: #FF416C !important;
    }
</style>