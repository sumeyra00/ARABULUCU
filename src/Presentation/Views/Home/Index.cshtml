@model ARABULUCU.Web.Controllers.ItemSearchViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
    var categories = ViewBag.Categories as IEnumerable<string> ?? Array.Empty<string>();
}

<section class="py-5" style="background: radial-gradient(circle at 50% 15%, #FFF0F4 0%, #FFF7F9 60%, #FCF9F9 100%);">
    <div class="container" style="max-width: 1100px;">
        <div class="text-center mb-5">
            <h1 class="fw-bolder text-dark mb-3">Bir şey mi kaybettiniz, yoksa bir şey mi buldunuz?</h1>
            <p class="text-muted mb-4">İlanları filtreleyin veya yeni bir kayıp/buluntu bildirimi oluşturun.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-action="KayipOlustur" class="btn btn-danger rounded-pill px-4">Kayıp İlanı Ver</a>
                <a asp-action="BulunanOlustur" class="btn btn-success rounded-pill px-4">Bulunan Eşya Bildir</a>
            </div>
        </div>

        <form asp-controller="Home" asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-5">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Criteria.Query" class="form-label">Başlık veya açıklama</label>
                    <input asp-for="Criteria.Query" name="Query" class="form-control" placeholder="Örn. siyah cüzdan" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Criteria.Category" class="form-label">Kategori</label>
                    <select asp-for="Criteria.Category" name="Category" class="form-select">
                        <option value="">Tüm kategoriler</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.Location" class="form-label">Konum</label>
                    <input asp-for="Criteria.Location" name="Location" class="form-control" placeholder="Konumda ara" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.IsFound" class="form-label">İlan türü</label>
                    <select asp-for="Criteria.IsFound" name="IsFound" class="form-select">
                        <option value="">Kayıp ve bulunan</option>
                        <option value="false">Kayıp</option>
                        <option value="true">Bulunan</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.IsItemFound" class="form-label">Bulunma durumu</label>
                    <select asp-for="Criteria.IsItemFound" name="IsItemFound" class="form-select">
                        <option value="">Tümü</option>
                        <option value="false">Henüz bulunmadı</option>
                        <option value="true">Bulundu</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.Brand" class="form-label">Marka</label>
                    <input asp-for="Criteria.Brand" name="Brand" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.Model" class="form-label">Model</label>
                    <input asp-for="Criteria.Model" name="Model" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.Color" class="form-label">Renk</label>
                    <input asp-for="Criteria.Color" name="Color" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.EventDateFrom" class="form-label">Olay tarihi başlangıcı</label>
                    <input asp-for="Criteria.EventDateFrom" type="date" name="EventDateFrom" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.EventDateTo" class="form-label">Olay tarihi bitişi</label>
                    <input asp-for="Criteria.EventDateTo" type="date" name="EventDateTo" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Criteria.IsDelivered" class="form-label">Teslim durumu</label>
                    <select asp-for="Criteria.IsDelivered" name="IsDelivered" class="form-select">
                        <option value="">Tümü</option>
                        <option value="false">Teslim edilmedi</option>
                        <option value="true">Teslim edildi</option>
                    </select>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Filtrele</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Temizle</a>
                </div>
            </div>
        </form>

        @if (Model.ValidationError is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.ValidationError</div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">İlanlar</h2>
            <span class="text-muted small">@Model.Items.Count sonuç</span>
        </div>
        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-light border text-center">Filtrelerinize uygun ilan bulunamadı.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model.Items)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between gap-2 mb-2">
                                    <span class="badge @(item.IsFound ? "text-bg-success" : "text-bg-danger")">@(item.IsFound ? "Bulunan" : "Kayıp")</span>
                                    <span class="badge text-bg-light">@item.Category.Name</span>
                                </div>
                                <h3 class="h5 fw-bold">@item.Title</h3>
                                <p class="text-muted small mb-2">@item.Location</p>
                                <p class="small mb-2">Olay tarihi: @item.EventDate.ToString("dd.MM.yyyy HH:mm")</p>
                                <p class="small mb-3">@(item.IsItemFound ? "Eşya bulundu" : "Eşya henüz bulunmadı") · @(item.IsDelivered ? "Teslim edildi" : "Teslim edilmedi")</p>
                                <a asp-controller="Home" asp-action="Detay" asp-route-ilanId="@item.Id" class="btn btn-outline-danger rounded-pill mt-auto">İlan detayları</a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
