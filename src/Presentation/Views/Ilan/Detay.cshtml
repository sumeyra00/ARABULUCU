@{
    ViewData["Title"] = "İlan Detayı";
}

<div class="container py-5">
    <div class="row g-4">
        
        <!-- Sol Kolon: Fotoğraf & Güvenlik Kilidi -->
        <div class="col-lg-5">
            <div class="card shadow-sm border rounded-3 overflow-hidden">
                
                <!-- Maskelenmiş / Bulanık Görsel Alanı -->
                <div class="position-relative d-flex align-items-center justify-content-center bg-light text-center p-4" style="min-height: 320px;">
                    <div style="filter: blur(8px); opacity: 0.35; font-size: 5rem; user-select: none;">
                        🎒
                    </div>

                    <!-- Kilit Katmanı (Overlay) -->
                    <div class="position-absolute top-50 start-50 translate-middle w-75 p-3 bg-white rounded-3 shadow border text-center">
                        <div class="fs-2 mb-1">🔒</div>
                        <h6 class="fw-bold mb-1">Görsel Maskelenmiştir</h6>
                        <p class="small text-muted mb-3">
                            Sahte talepleri önlemek için görsel gizlidir. Eşyanın size ait olduğunu doğrulamak için soruya cevap verin.
                        </p>
                        <button type="button" class="btn btn-sm btn-outline-danger fw-bold" data-bs-toggle="modal" data-bs-target="#verificationModal">
                            Doğrulama Sorusunu Yanıtla
                        </button>
                    </div>
                </div>

                <div class="card-footer bg-white border-top small text-muted text-center py-2">
                    🛡️ Kampüs İçi Güvenli Eşleşme Devrede
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: İlan Bilgileri & Sohbet (Chat) Başlatma -->
        <div class="col-lg-7">
            <div class="card shadow-sm border rounded-3 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    
                    <!-- Durum & Kategori Rozetleri -->
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-pill px-3 py-2">Kayıp Eşya</span>
                            <span class="badge bg-secondary rounded-pill px-3 py-2">Çanta & Sırt Çantası</span>
                        </div>
                        <span class="small text-muted">İlan No: #10482</span>
                    </div>

                    <!-- İlan Başlığı -->
                    <h3 class="fw-bold mb-2">Siyah Deri Sırt Çantası</h3>
                    <p class="text-muted small mb-4">
                        <i class="bi bi-clock me-1"></i> İlan Tarihi: 19 Ekim 2026
                    </p>

                    <!-- Detay Bilgi Kutuları -->
                    <div class="row g-2 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="small text-muted fw-semibold">Konum</div>
                                <div class="fw-bold text-dark mt-1">📍 Merkez Kütüphane (2. Kat)</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="small text-muted fw-semibold">Tarih / Saat</div>
                                <div class="fw-bold text-dark mt-1">📅 18 Ekim 2026, 14:30</div>
                            </div>
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="mb-4">
                        <h6 class="fw-bold">Açıklama:</h6>
                        <p class="text-secondary small mb-0">
                            İçinde ders notları, hesap makinesi ve kırmızı bir kalemlik vardı. Sol askısında hafif bir aşınma izi bulunmaktadır. Eşyayı gören veya bulan kişinin iletişime geçmesi rica olunur.
                        </p>
                    </div>

                    <!-- İlan Sahibi Bilgisi -->
                    <div class="p-3 bg-light rounded-3 border mb-4 mt-auto">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                                    FN
                                </div>
                                <div>
                                    <div class="fw-bold">Fatmanur A.</div>
                                    <div class="small text-muted">Öğrenci • Mühendislik Fakültesi</div>
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">Aktif</span>
                        </div>
                    </div>

                    <!-- CHAT / MESAJLAŞMA BUTONLARI -->
                    <div class="row g-2">
                        <div class="col-md-7">
                            <!-- Hızlı Sohbet Modalını Açar -->
                            <button type="button" class="btn btn-primary fw-bold w-100 py-2 d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#chatModal">
                                💬 İlan Sahibiyle Sohbet Başlat
                            </button>
                        </div>
                        <div class="col-md-5">
                            <!-- Tam Sayfa Mesajlaşmaya Gider -->
                            <a href="/Home/Mesajlar" class="btn btn-outline-secondary fw-semibold w-100 py-2">
                                Tüm Mesajlara Git
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<!-- 1. DOĞRULAMA SORUSU MODAL PENCERESİ -->
<div class="modal fade" id="verificationModal" tabindex="-1" aria-labelledby="verificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="verificationModalLabel">🔒 Güvenlik Doğrulama Sorusu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    İlan sahibinin hazırladığı bu soruya doğru cevap vererek görselin kilidini açabilir ve eşleşmeyi doğrulayabilirsiniz.
                </p>
                <div class="alert alert-light border fw-semibold mb-3">
                    ❓ Soru: "Çantanın ön gözündeki küçük anahtarlıkta hangi figür vardı?"
                </div>
                <div class="mb-3">
                    <label for="claimantAnswer" class="form-label fw-semibold">Cevabınız</label>
                    <input type="text" class="form-control" id="claimantAnswer" placeholder="Cevabınızı buraya yazın..." />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger fw-bold">Cevabı Onayla & Kilidi Aç</button>
            </div>
        </div>
    </div>
</div>

<!-- 2. HIZLI CHAT / SOHBET MODAL PENCERESİ -->
<div class="modal fade" id="chatModal" tabindex="-1" aria-labelledby="chatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                        FN
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold mb-0" id="chatModalLabel">Fatmanur A. ile Sohbet</h6>
                        <small class="text-muted" style="font-size: 0.75rem;">İlan: Siyah Deri Sırt Çantası</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <!-- Mesajlaşma Gövdesi -->
            <div class="modal-body" style="background-color: #F8FAFC; min-height: 300px;">
                <div class="text-center mb-3">
                    <span class="badge bg-light text-muted border small">Görüşme Başlatıldı • 19 Ekim 2026</span>
                </div>

                <!-- Karşı Tarafın Mesajı -->
                <div class="d-flex flex-column align-items-start mb-3">
                    <div class="bg-white p-2 px-3 rounded-3 shadow-sm border small" style="max-width: 80%;">
                        Merhaba, çantayı Merkez Kütüphane 2. katta ben bulmuştum. Size mi ait acaba?
                    </div>
                    <span class="text-muted mt-1 ps-1" style="font-size: 0.7rem;">19:15</span>
                </div>

                <!-- Benim Mesajım -->
                <div class="d-flex flex-column align-items-end mb-3">
                    <div class="bg-primary text-white p-2 px-3 rounded-3 shadow-sm small" style="max-width: 80%;">
                        Evet merhaba! Çok teşekkür ederim, tam kütüphanede unutmuştum. Yarın teslim alabilir miyim?
                    </div>
                    <span class="text-muted mt-1 pe-1" style="font-size: 0.7rem;">19:17</span>
                </div>
            </div>

            <!-- Mesaj Gönderme Kutusu -->
            <div class="modal-footer bg-white p-2">
                <form class="d-flex w-100 gap-2">
                    <input type="text" class="form-control" placeholder="Bir mesaj yazın..." required />
                    <button type="submit" class="btn btn-primary fw-bold px-3">Gönder</button>
                </form>
            </div>
        </div>
    </div>
</div>