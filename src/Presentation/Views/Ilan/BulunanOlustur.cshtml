@{
    ViewData["Title"] = "Bulunan Eşya Bildir";
}

<div class="position-relative overflow-hidden py-5" style="background: radial-gradient(circle at 50% 15%, #FFF0F4 0%, #FFF7F9 60%, #FCF9F9 100%); min-height: 100vh;">

    <!-- Sevimli Süs Figürleri -->
    <div class="position-absolute d-none d-lg-block" style="top: 8%; left: 5%; font-size: 2.2rem; transform: rotate(-15deg); user-select: none;">🎁</div>
    <div class="position-absolute d-none d-lg-block" style="top: 10%; right: 6%; font-size: 2.4rem; transform: rotate(18deg); user-select: none;">✨</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 8%; left: 5%; font-size: 2rem; transform: rotate(12deg); user-select: none;">🔒</div>
    <div class="position-absolute d-none d-lg-block" style="bottom: 10%; right: 5%; font-size: 2.2rem; transform: rotate(-12deg); user-select: none;">🌸</div>

    <div class="container position-relative" style="z-index: 2; max-width: 760px;">
        
        <!-- Geri Dön Butonu -->
        <div class="mb-3">
            <a href="/" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-dark shadow-sm bg-white border">
                &larr; Ana Sayfaya Dön
            </a>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);">
            
            <!-- Kart Başlığı -->
            <div class="card-header border-bottom py-4 px-4 px-md-5 text-center" style="background: linear-gradient(135deg, #FFF0F4 0%, #FFE2EA 100%);">
                <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm mb-3" style="width: 56px; height: 56px; background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); font-size: 1.6rem; box-shadow: 0 4px 12px rgba(255, 96, 130, 0.35);">
                    🎁
                </div>
                <h3 class="fw-bold mb-1 text-dark">Bulunan Eşya Bildir</h3>
                <p class="text-muted small mb-0">Eşyanın gerçek sahibine ulaşabilmesi için gizli doğrulama sorusuyla bildirim oluşturun.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form method="post" action="#" enctype="multipart/form-data">
                    
                    <!-- İlan Başlığı -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Eşya Tanımı / Başlık</label>
                        <input type="text" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" placeholder="Örn: Siyah Sırt Çantası, Mavi Anahtarlık..." required />
                    </div>

                    <!-- Kategori ve Konum (Hem Seçilebilir Hem Yazılabilir) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Eşya Kategorisi</label>
                            <input list="bulunanKategoriList" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" placeholder="Kategori seçin veya yazın..." required />
                            <datalist id="bulunanKategoriList">
                                <option value="Cüzdan & Para"></option>
                                <option value="Öğrenci Kimliği & Kartvizit"></option>
                                <option value="Anahtar & Anahtarlık"></option>
                                <option value="Telefon & Tablet"></option>
                                <option value="Dizüstü Bilgisayar & Şarj Aleti"></option>
                                <option value="Kulaklık & Ses Cihazları"></option>
                                <option value="Çanta & Sırt Çantası"></option>
                                <option value="Gözlük & Saat"></option>
                                <option value="Giyim, Mont & Atkı"></option>
                                <option value="Kitap, Defter & Ders Notu"></option>
                                <option value="Su Matarası & Termos"></option>
                                <option value="Spor Eşyası"></option>
                                <option value="Diğer Kişisel Eşyalar"></option>
                            </datalist>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Bulunduğu Yer / Fakülte</label>
                            <input list="bulunanKonumList" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" placeholder="Fakülte seçin veya yazın..." required />
                            <datalist id="bulunanKonumList">
                                <option value="Merkez Yemekhane"></option>
                                <option value="Merkez Kütüphane"></option>
                                <option value="Merkezi Kafeterya"></option>
                                <option value="Öğrenci İşleri Daire Bşk."></option>
                                <option value="Kapalı Spor Salonu"></option>
                                <option value="Stadyum & Halı Sahalar"></option>
                                <option value="Kültür Merkezi"></option>
                                <option value="Mühendislik Fakültesi"></option>
                                <option value="Tıp Fakültesi"></option>
                                <option value="Diş Hekimliği Fakültesi"></option>
                                <option value="Eczacılık Fakültesi"></option>
                                <option value="Sağlık Bilimleri Fakültesi"></option>
                                <option value="Fen Fakültesi"></option>
                                <option value="Edebiyat Fakültesi"></option>
                                <option value="İktisadi ve İdari Bilimler Fakültesi"></option>
                                <option value="İlahiyat Fakültesi"></option>
                                <option value="Eğitim Fakültesi"></option>
                                <option value="İletişim Fakültesi"></option>
                                <option value="Mimarlık, Güzel Sanatlar ve Tasarım Fakültesi"></option>
                                <option value="Hukuk Fakültesi"></option>
                                <option value="Turizm Fakültesi"></option>
                                <option value="Veteriner Fakültesi"></option>
                                <option value="Sivas Teknik Bilimler MYO"></option>
                                <option value="Cumhuriyet MYO"></option>
                                <option value="Kampüs İçi Otobüs / Duraklar"></option>
                            </datalist>
                        </div>
                    </div>

                    <!-- Bulunma Tarihi & Saati -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Bulunma Tarihi</label>
                            <input type="date" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Bulunma Saati</label>
                            <input type="time" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" />
                        </div>
                    </div>

                    <!-- SAHİPLİK DOĞRULAMA KUTUSU (GÜVENLİK) -->
                    <div class="p-3 rounded-4 border mb-3" style="background-color: #FFF7F9; border-color: #FFD9E2 !important;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="fs-5">🔒</span>
                            <span class="fw-bold text-dark small">Sahiplik Doğrulama Sorusu (Önemli)</span>
                        </div>
                        <p class="small text-muted mb-2">
                            Eşyanın sahte taleplerle alınmasını önlemek için sadece gerçek sahibinin bilebileceği bir detay sorusu ve cevabı belirleyin.
                        </p>
                        <div class="mb-2">
                            <input type="text" class="form-control bg-white border rounded-pill px-3 py-2 shadow-none small" placeholder="Soru: Örn: Çantanın ön gözünde ne vardı?" required />
                        </div>
                        <div>
                            <input type="text" class="form-control bg-white border rounded-pill px-3 py-2 shadow-none small" placeholder="Doğru Cevap: Örn: Kırmızı kalemlik" required />
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Açıklama (Genel Bilgi)</label>
                        <textarea rows="3" class="form-control bg-light border rounded-4 p-3 shadow-none" placeholder="Doğrulama sorusunun cevabını ele vermeyecek şekilde genel bilgiler yazın..." required></textarea>
                    </div>

                    <!-- Fotoğraf Yükleme -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Fotoğraf Yükle (İlanda maskelenecektir)</label>
                        <input type="file" class="form-control bg-light border rounded-pill px-3 py-2 shadow-none" accept="image/*" />
                    </div>

                    <!-- Bildirimi Gönder Butonu -->
                    <button type="button" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); border: none;">
                        🌸 Bulunan Eşyayı Bildir
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>