@model FoundItemViewModel

@{
    ViewData["Title"] = "Bulunan Eşya Bildir";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <div class="card shadow-sm border rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="mb-1 fw-bold text-success">🎁 Bir Şey Buldum — Buluntu Eşya Bildir</h4>
                    <p class="text-muted small mb-0">Sahibinin eşyayı hızlıca bulabilmesi için lütfen bilgileri eksiksiz doldurun.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="BulunanOlustur" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <!-- 1. Temel Eşya Bilgileri -->
                        <h6 class="fw-bold mb-3 border-bottom pb-2">1. Eşya Bilgileri</h6>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Bulunan Eşya Başlığı</label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Siyah cüzdan" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Kategori</label>
                                <select asp-for="CategoryId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    <option value="1">👛 Cüzdan & Kartlık</option>
                                    <option value="2">🔑 Anahtar</option>
                                    <option value="3">📱 Telefon</option>
                                    <option value="4">🎧 Kulaklık</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FoundDate" class="form-label fw-semibold">Bulunduğu Tarih & Saat</label>
                                <input asp-for="FoundDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="FoundDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 2. Konum Bilgileri -->
                        <h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">2. Bulunduğu Kampüs Konumu</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CampusArea" class="form-label fw-semibold">Kampüs Bölgesi</label>
                                <select asp-for="CampusArea" class="form-select">
                                    <option value="">Bölge Seçiniz...</option>
                                    <option value="yemekhane">🍽️ Merkez Yemekhane</option>
                                    <option value="kutuphane">📚 Merkez Kütüphane</option>
                                    <option value="kiz_kyk">🏢 Kız Öğrenci Yurdu (KYK)</option>
                                    <option value="erkek_kyk">🏢 Erkek Öğrenci Yurdu (KYK)</option>
                                    <option value="hastane">🏥 Tıp Fakültesi Hastanesi</option>
                                    <option value="muhendislik">⚙️ Mühendislik Fakültesi</option>
                                    <option value="egitim">📖 Eğitim Fakültesi</option>
                                    <option value="iibf">💼 İİBF</option>
                                    <option value="kafeler">☕ Kampüs Kafeler & Çarşı Alanı</option>
                                    <option value="diger_alan">📍 Diğer Açık Alanlar</option>
                                </select>
                                <span asp-validation-for="CampusArea" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LocationDetail" class="form-label fw-semibold">Tam Konum / Nerede Bulundu?</label>
                                <input asp-for="LocationDetail" class="form-control" placeholder="Örn: Yemekhane 1. kat sıra masalarının altı" />
                                <span asp-validation-for="LocationDetail" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 3. Eşyanın Mevcut Durumu & Teslim Yeri -->
                        <h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">3. Eşya Şu An Nerede?</h6>

                        <div class="mb-3">
                            <div class="form-check mb-2">
                                <input asp-for="ItemStatus" class="form-check-input" type="radio" id="statusWithMe" value="with_me">
                                <label class="form-check-label fw-semibold" for="statusWithMe">
                                    Eşya şu an bende (Sahibi sistem üzerinden benimle iletişime geçsin)
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="ItemStatus" class="form-check-input" type="radio" id="statusDelivered" value="delivered">
                                <label class="form-check-label fw-semibold" for="statusDelivered">
                                    Yetkili birime teslim ettim (Fakülte güvenliği, danışma veya yurt idaresi)
                                </label>
                            </div>
                            <span asp-validation-for="ItemStatus" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeliveredTo" class="form-label fw-semibold">Teslim Ettiyseniz Nereye/Kime Bıraktınız?</label>
                            <input asp-for="DeliveredTo" class="form-control" placeholder="Örn: Mühendislik Fakültesi Zemin Kat Güvenlik Birimi" />
                            <span asp-validation-for="DeliveredTo" class="text-danger"></span>
                        </div>

                        <!-- 4. Fotoğraf & Ayırt Edici Detay -->
                        <h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">4. Fotoğraf & Güvenlik İpucu</h6>

                        <div class="mb-3">
                            <label asp-for="ItemPhoto" class="form-label fw-semibold">Bulunan Eşyanın Fotoğrafı</label>
                            <input asp-for="ItemPhoto" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" />
                            <span asp-validation-for="ItemPhoto" class="text-danger"></span>
                            <div class="form-text small text-muted">Fotoğraf sistemde ilk başta otomatik olarak hafif bulanık (blurred) gösterilecektir.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SecurityQuestion" class="form-label fw-semibold">Sahibine Sorulacak Doğrulama Sorusu</label>
                            <input asp-for="SecurityQuestion" class="form-control" placeholder="Örn: Cüzdanın içinde hangi kart vardı?" />
                            <span asp-validation-for="SecurityQuestion" class="text-danger"></span>
                            <div class="form-text small text-muted">Gerçek sahibini ayırt etmek için sadece sahibinin bilebileceği bir detay sorusu yazın.</div>
                        </div>

                        <!-- Kaydet Butonu -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success fw-bold py-2">Bulunan Eşyayı Bildir</button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>