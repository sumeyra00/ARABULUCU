@model LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border rounded-3">
                <div class="card-body p-4">

                    <!-- Başlık & Bilgi -->
                    <h3 class="card-title text-center mb-1 fw-bold">Giriş Yap</h3>
                    <p class="text-center text-muted small mb-4">
                        Kayıp veya bulunan eşyalarınızı yönetmek için giriş yapın.
                    </p>

                    @if (TempData["RegisterSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                    {
                        <div class="alert alert-info" role="alert">
                            İlan vermek için giriş yapın. Hesabınız yoksa
                            <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">kayıt olun</a>.
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Giriş Formu -->
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <input asp-for="ReturnUrl" type="hidden" />

                        <!-- E-posta -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@cumhuriyet.edu.tr" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Şifre -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Beni Hatırla & Şifremi Unuttum -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small"></label>
                            </div>
                            <a href="#" class="small text-decoration-none">Şifremi Unuttum?</a>
                        </div>

                        <!-- Giriş Butonu -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary fw-bold py-2">Giriş Yap</button>
                        </div>

                    </form>

                </div>

                <!-- Alt Yönlendirme (Kayıt Ol) -->
                <div class="card-footer bg-light text-center py-3">
                    <span class="small text-muted">Henüz hesabınız yok mu? </span>
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="small text-decoration-none fw-bold">Üye Ol</a>
                </div>
            </div>

        </div>
    </div>
</div>