@model LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border rounded-3">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-1 fw-bold">Giriş Yap</h3>
                    <p class="text-center text-muted small mb-4">
                        Kayıp veya bulunan eşyalarınızı yönetmek için giriş yapın.
                    </p>

                    @if (TempData["RegisterSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                    {
                        <div class="alert alert-info" role="alert">
                            Girişten sonra kayıp ilanı verebilir veya bulduğunuz eşyayı bildirebilirsiniz. Hesabınız yoksa
                            <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">kayıt olun</a>.
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        @{
                            var returnUrl = Model.ReturnUrl;
                            var isKnownReturnUrl = returnUrl is "/" or "/Home/Index"
                                or "/Home/KayipOlustur" or "/Home/BulunanOlustur";
                        }
                        <div class="mb-3">
                            <label asp-for="ReturnUrl" class="form-label fw-semibold">Girişten sonra ne yapmak istiyorsun?</label>
                            <select asp-for="ReturnUrl" class="form-select">
                                @if (!string.IsNullOrWhiteSpace(returnUrl) && !isKnownReturnUrl)
                                {
                                    <option value="@returnUrl">Önceki sayfaya devam et</option>
                                }
                                <option value="/">Ana sayfaya git</option>
                                <option value="/Home/KayipOlustur">Kayıp ilanı ver</option>
                                <option value="/Home/BulunanOlustur">Bulunan eşya bildir</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@cumhuriyet.edu.tr" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary fw-bold py-2">Giriş Yap</button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <span class="small text-muted">Henüz hesabınız yok mu? </span>
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="small text-decoration-none fw-bold">Üye Ol</a>
                </div>
            </div>
        </div>
    </div>
</div>
