@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border rounded-3">
                <div class="card-body p-4">

                    <!-- Başlık & Bilgi -->
                    <h3 class="card-title text-center mb-1 fw-bold">Giriş Yap</h3>
                    <p class="text-center text-muted small mb-4">
                        Kayıp veya bulunan eşyalarınızı yönetmek için giriş yapın.
                    </p>

                    <!-- Giriş Formu -->
                    <form method="post" action="#">

                        <!-- E-posta -->
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">E-posta Adresi</label>
                            <input type="email" class="form-control" id="email" name="email" placeholder="ornek@cumhuriyet.edu.tr" required />
                        </div>

                        <!-- Şifre -->
                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">Şifre</label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required />
                        </div>

                        <!-- Beni Hatırla & Şifremi Unuttum -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" />
                                <label class="form-check-label small" for="rememberMe">Beni Hatırla</label>
                            </div>
                            <a href="#" class="small text-decoration-none">Şifremi Unuttum?</a>
                        </div>

                        <!-- Giriş Butonu -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary fw-bold py-2">Giriş Yap</button>
                        </div>

                        <!-- Ayraç -->
                        <div class="text-center my-3">
                            <span class="text-muted small">veya</span>
                        </div>

                        <!-- Google ile Giriş -->
                        <div class="d-grid mb-3">
                            <button type="button" class="btn btn-outline-secondary py-2">
                                Google ile Devam Et
                            </button>
                        </div>

                    </form>

                </div>

                <!-- Alt Yönlendirme (Kayıt Ol) -->
                <div class="card-footer bg-light text-center py-3">
                    <span class="small text-muted">Henüz hesabınız yok mu? </span>
                    <a href="/Account/Register" class="small text-decoration-none fw-bold">Üye Ol</a>
                </div>
            </div>

        </div>
    </div>
</div>