@model ARABULUCU.Web.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="position-relative overflow-hidden py-5 d-flex align-items-center justify-content-center" style="background: radial-gradient(circle at 50% 20%, #FFF0F4 0%, #FFF7F9 60%, #FCF9F9 100%); min-height: calc(100vh - 160px);">
    <div class="container position-relative" style="z-index: 2; max-width: 440px;">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98);">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm mb-3" style="width: 52px; height: 52px; background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); font-size: 1.5rem;">
                        🔐
                    </div>
                    <h1 class="h3 fw-bold text-dark mb-1">Giriş Yap</h1>
                    <p class="text-muted small mb-0">Kayıp veya bulunan eşyalarınızı yönetmek için giriş yapın.</p>
                </div>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="status">@successMessage</div>
                }

                <form method="post" action="/Account/Login">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
                    }

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">E-posta Adresi</label>
                        <input type="email" class="form-control" id="email" name="Email" value="@Model.Email" autocomplete="username" placeholder="ornek@cumhuriyet.edu.tr" required />
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">Şifre</label>
                        <input type="password" class="form-control" id="password" name="Password" autocomplete="current-password" placeholder="••••••••" required />
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe" name="RememberMe" value="true" checked="@Model.RememberMe" />
                            <label class="form-check-label small" for="rememberMe">Beni Hatırla</label>
                        </div>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #FF6082 0%, #FF416C 100%); border: none;">
                        Giriş Yap
                    </button>
                </form>
            </div>

            <div class="card-footer border-top-0 py-3 text-center" style="background-color: #FFF0F4;">
                <p class="mb-0 small text-muted">
                    Henüz hesabınız yok mu?
                    <a href="/Account/Register" class="fw-bold text-decoration-none" style="color: #FF416C;">Üye Ol</a>
                </p>
            </div>
        </div>
    </div>
</div>
