@{
    ViewData["Title"] = "E-postanızı Kontrol Edin";
}

<div class="container py-5" style="max-width: 520px; min-height: 65vh;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-sm-5 text-center">
            <h1 class="h3 fw-bold mb-3">E-postanızı kontrol edin</h1>
            <p class="text-muted">Bu e-posta adresi için bir hesap varsa, şifre yenileme bağlantısı gönderildi. Bağlantı gelmezse gereksiz/spam klasörünü kontrol edin.</p>
            <a asp-action="Login" class="btn rounded-pill px-4 text-white" style="background: #FF416C;">Giriş sayfasına dön</a>
        </div>
    </div>
</div>
