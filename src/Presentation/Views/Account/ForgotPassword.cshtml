@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container py-5" style="max-width: 520px; min-height: 65vh;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-sm-5">
            <h1 class="h3 fw-bold mb-2">Şifremi Unuttum</h1>
            <p class="text-muted mb-4">Hesabınıza kayıtlı e-posta adresini girin. Şifrenizi yenilemeniz için bir bağlantı göndereceğiz.</p>
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn w-100 rounded-pill py-2 fw-bold text-white" style="background: #FF416C; border: none;">Sıfırlama Bağlantısı Gönder</button>
            </form>
            <div class="text-center mt-3">
                <a asp-action="Login" class="text-decoration-none" style="color: #FF416C;">Giriş sayfasına dön</a>
            </div>
        </div>
    </div>
</div>
