@model RegisterViewModel

@{
    ViewData["Title"] = "Üye Ol";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            
            <div class="card shadow-sm border rounded-3">
                <div class="card-body p-4">
                    
                    <!-- Başlık & Bilgi -->
                    <h3 class="card-title text-center mb-1 fw-bold">Hesap Oluştur</h3>
                    <p class="text-center text-muted small mb-4">
                        Sivas Cumhuriyet Üniversitesi kampüsünde kayıp eşyalarını bulmak ve bildirmek için üye ol.
                    </p>

                    @if (TempData["RegisterSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Kayıt Formu -->
                    <form asp-controller="Account" asp-action="Register" method="post">
                        
                        <!-- Ad Soyad -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Adınız ve Soyadınız" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- E-posta -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Üniversite E-posta Adresi</label>
                            <input asp-for="Email" class="form-control" placeholder="ogrenciNo@cumhuriyet.edu.tr" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Telefon Numarası -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon Numarası (Opsiyonel)</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="05XX XXX XX XX" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            <div class="form-text small text-muted">Eşya teslimlerinde iletişim kolaylığı sağlamak içindir.</div>
                        </div>

                        <!-- Şifre Alanları -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-semibold"></label>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Şartlar & Onay -->
                        <div class="mb-3 form-check">
                            <input asp-for="TermsAccepted" class="form-check-input" />
                            <label asp-for="TermsAccepted" class="form-check-label small">
                                <a href="#" class="text-decoration-none">Kullanım Koşulları</a> ve <a href="#" class="text-decoration-none">KVKK Aydınlatma Metnini</a> okudum, onaylıyorum.
                            </label>
                            <span asp-validation-for="TermsAccepted" class="text-danger small d-block"></span>
                        </div>

                        <!-- Kayıt Ol Butonu -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary fw-bold py-2">Üye Ol</button>
                        </div>

                    </form>

                </div>

                <!-- Alt Yönlendirme (Giriş Yap) -->
                <div class="card-footer bg-light text-center py-3">
                    <span class="small text-muted">Zaten hesabınız var mı? </span>
                    <a href="/Home/Login" class="small text-decoration-none fw-bold">Giriş Yap</a>
                </div>
            </div>

        </div>
    </div>
</div>