<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARABULUCU</title>
    <!-- Leaflet CSS (harita göstermek için) - CDN kullanabilirsiniz -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="" crossorigin="" />
    <link rel="stylesheet" href="/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="container">
        <header>
            <h1>ARABULUCU</h1>
        </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer>
            <hr />
            <p>&copy; Üniversite Kampüsü - ARABULUCU</p>
        </footer>
    </div>

    <!-- SignalR client ve Leaflet JS - CDN kullanımı örneği -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- SignalR client (sürüm uyumuna dikkat edin) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
